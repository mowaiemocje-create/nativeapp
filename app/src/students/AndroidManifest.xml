<?xml version="1.0" encoding="utf-8"?>
<!-- TYLKO WERSJA KURSANTOW (APK z nowamowa.com). Laczy sie z app/src/main/AndroidManifest.xml.
     Tych rzeczy nie moze byc w wersji Google Play (zasady sklepu). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- samoaktualizacja (UpdateChecker): instalacja nowego apka.apk -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- okienko "Zezwolic na dzialanie w tle bez ograniczen?" (Google Play ogranicza te zgode) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- wykrywanie rozmowy (nagrywanie rozmow) — tylko stan: dzwoni / trwa / koniec, bez numerow -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application>
        <!-- POWIADOMIENIA PUSH (Firebase): "Chcę porozmawiać" dochodzi od razu -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- NAGRYWANIE ROZMOW (jak Cube ACR): usluga ulatwien dostepu pozwala nagrywac w czasie rozmowy -->
        <service
            android:name=".CallRecService"
            android:label="@string/callrec_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:foregroundServiceType="microphone"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/callrec_accessibility" />
        </service>
    </application>
</manifest>
