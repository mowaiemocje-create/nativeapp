<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pr_bg"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <!-- Obszar wykresu (DAW) -->
    <com.pitchrec.nativetest.PitchWaveView
        android:id="@+id/pitchWaveView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gotowy"
        android:textSize="12sp"
        android:textColor="@color/pr_muted"
        android:gravity="center"
        android:padding="4dp"
        android:background="@color/pr_card" />

    <!-- Panel kontrolny (.ctrl) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/pr_card"
        android:padding="10dp">

        <!-- Suwak MIC (gain) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="MIC"
                android:textSize="10sp"
                android:textColor="@color/pr_muted" />
            <com.pitchrec.nativetest.SliderView
                android:id="@+id/gainSlider"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/gainValueText"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textSize="10sp"
                android:textColor="@color/pr_text"
                android:gravity="end" />
        </LinearLayout>

        <!-- Suwak ZOOM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="ZOOM"
                android:textSize="10sp"
                android:textColor="@color/pr_muted" />
            <com.pitchrec.nativetest.SliderView
                android:id="@+id/zoomSlider"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/zoomValueText"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="ALL"
                android:textSize="10sp"
                android:textColor="@color/pr_text"
                android:gravity="end" />
        </LinearLayout>

        <!-- Miernik poziomu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="POZIOM"
                android:textSize="9sp"
                android:textColor="@color/pr_muted" />
            <ProgressBar
                android:id="@+id/levelMeter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <!-- Rzad przyciskow (.br) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <com.pitchrec.nativetest.NeonButton
                android:id="@+id/playButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <com.pitchrec.nativetest.NeonButton
                android:id="@+id/recordButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <com.pitchrec.nativetest.NeonButton
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="00:00:00"
                android:textColor="@color/pr_text"
                android:textSize="13sp"
                android:background="@color/pr_bg" />

            <Button
                android:id="@+id/resetButton"
                android:minWidth="0dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="↺"
                android:textColor="@color/pr_text"
                android:background="@drawable/btn_neutral" />

            <Button
                android:id="@+id/autoGainButton"
                android:minWidth="0dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55"
                android:layout_marginEnd="4dp"
                android:text="AG\nOFF"
                android:textSize="9sp"
                android:textColor="@color/pr_muted"
                android:background="@drawable/btn_neutral" />

            <Button
                android:id="@+id/blackScreenButton"
                android:minWidth="0dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55"
                android:text="⬛\nBS"
                android:textSize="9sp"
                android:textColor="@color/pr_muted"
                android:background="@drawable/btn_neutral" />

        </LinearLayout>

    </LinearLayout>

    <!-- Dolne menu nawigacji — jak w PitchRec, NIEAKTYWNE na razie (logowanie/menu NS to
         kolejny, osobny etap prac). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@color/pr_card">

        <Button
            android:id="@+id/recordingsListButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📁\nNagrania"
            android:textSize="13sp"
            android:textColor="@color/pr_accent"
            android:background="@android:color/transparent" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✓\nKorekta"
            android:textSize="13sp"
            android:textColor="@color/pr_muted"
            android:background="@android:color/transparent"
            android:enabled="false" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📖\nDziennik"
            android:textSize="13sp"
            android:textColor="@color/pr_muted"
            android:background="@android:color/transparent"
            android:enabled="false" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📊\nStatystyki"
            android:textSize="13sp"
            android:textColor="@color/pr_muted"
            android:background="@android:color/transparent"
            android:enabled="false" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙\nUstawienia"
            android:textSize="13sp"
            android:textColor="@color/pr_accent"
            android:background="@android:color/transparent" />

    </LinearLayout>

</LinearLayout>
